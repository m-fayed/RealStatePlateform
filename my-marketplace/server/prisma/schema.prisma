// Prisma schema — single source of truth for our database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A platform user. role decides what they can do.
// status decides whether they're allowed in yet (brokers wait for admin approval).
model User {
  id              String    @id @default(uuid())
  name            String
  phone           String    @unique
  email           String?
  password        String
  role            String    // "broker" | "seeker" | "admin"
  status          String    @default("active") // "pending" | "active" | "rejected" | "suspended"
  listingCredits  Int       @default(0)        // broker only — pay-per-listing credit balance
  licenseImageUrl String?   // broker only — path to uploaded license image
  adLicense       String?   // broker only — license number
  rejectionReason String?   // filled when admin rejects a broker registration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listings Listing[]
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsBroker Conversation[] @relation("ConversationBroker")
  messagesSent          Message[]      @relation("MessageSender")
  transactions          Transaction[]  // broker only — credit purchase requests

  @@index([role, status])
}

// A property listing. Belongs to one broker.
model Listing {
  id           String   @id @default(uuid())
  brokerId     String
  broker       User     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  title        String
  propertyType String   // apartment | villa | duplex | shop | office | warehouse | land
  offerType    String   // sale | rent
  price        Float
  city         String
  area         String?
  sizeSqm      Float?
  rooms        Int?
  floor        Int?
  description  String?
  images       String   @default("[]") // JSON-encoded array of URL strings (SQLite has no array type)
  adLicenseNo  String
  status       String   @default("active") // active | sold | rented | deleted
  viewsCount   Int      @default(0)
  isFeatured   Boolean  @default(false)
  featureType  String?  // "top" | "badge" | "premium" | null
  featuredUntil DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]

  @@index([status, createdAt])
  @@index([city])
  @@index([propertyType])
  @@index([offerType])
}

// One conversation per (listing, buyer). The buyer is whoever clicked "Chat"
// on a listing card. broker is denormalized at creation (= listing.brokerId)
// so inbox queries can scan one indexed column instead of joining.
model Conversation {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  brokerId  String
  broker    User     @relation("ConversationBroker", fields: [brokerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([brokerId, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// A broker's request to top up listing credits. One row per purchase attempt.
//
// Payment methods tailored for Egypt:
//   - "vodafone_cash" — real, manual: broker transfers to our wallet, enters
//     their sending number (+ optional receipt), status stays "pending" until
//     an admin verifies the transfer and approves. Approval grants the credits.
//   - "card" / "fawry" — mock sandbox: no real processor, confirmed instantly
//     on create (status "completed", credits granted immediately). For testing.
//
// amount/credits are snapshotted from the chosen package at purchase time so a
// later price change never rewrites history. Credits are only ever added to the
// broker on the pending -> completed transition (see admin.controller).
model Transaction {
  id              String    @id @default(uuid())
  brokerId        String
  broker          User      @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  packageId       String    // snapshot of the package id, e.g. "small" | "medium" | "large"
  amount          Float     // EGP charged for the package
  credits         Int       // listing credits to grant on completion
  method          String    // "vodafone_cash" | "card" | "fawry"
  status          String    @default("pending") // "pending" | "completed" | "rejected"
  senderNumber    String?   // vodafone_cash — wallet number the broker transferred from
  receiptUrl      String?   // optional uploaded transfer screenshot
  rejectionReason String?   // filled when an admin rejects the request
  reviewedById    String?   // admin who approved/rejected (null for instant sandbox)
  reviewedAt      DateTime? // when it moved out of "pending"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([brokerId, createdAt])
}
