PORT=5002
# Required in production: at least 32 cryptographically random characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Missing, whitespace, placeholders and obvious low-complexity values fail startup.
JWT_SECRET=
DATABASE_URL="file:./dev.db"
CORS_ORIGIN=http://localhost:5173
# Required for seeding and production startup. No default password is used.
ADMIN_EMAIL=
# 12–72 characters; uppercase, lowercase, number and symbol; no placeholders.
ADMIN_PASSWORD=
# Login remains phone-based; set this before seeding an administrator.
ADMIN_PHONE=+201000000000
# Optional absolute persistent storage directory; default is server/uploads.
# UPLOADS_DIR=
